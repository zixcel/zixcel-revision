    {
      "manifest": "Cargo.toml",
      "package": "zixcel-revision",
      "ecosystem": "rust",
      "description": "Bounded content-addressed revision streams, CAS and retention",
      "interfaces": {
        "lib": "src/lib.rs",
        "features": {
          "default": [],
          "redb": [
            "dep:redb",
            "dep:serde_json"
          ],
          "attestation": [
            "dep:ed25519-dalek",
            "dep:serde_json"
          ]
        },
        "bins": [],
        "public_modules": [
          "backend",
          "attestation",
          "durable"
        ],
        "public_reexports": [
          "external_port::ExternalRetention",
          "registration::{ExternalRegistration, ExternalRegistrationStatus, RetirementReceipt}",
          "retention::{ExternalObjectRef, ExternalRoot, ExternalRootKind, ReclamationPermit}",
          "backend::RedbBackend",
          "backend::{Backend, MemoryBackend}",
          "model::*",
          "state::CommitState",
          "store::CommitStore"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "conformance/registry/Cargo.toml",
      "package": "zixcel-revision-conformance",
      "ecosystem": "rust",
      "description": null,
      "interfaces": {
        "lib": null,
        "features": {
          "durable": [
            "zixcel-revision/redb"
          ]
        },
        "bins": [],
        "implicit_bins": [
          "conformance/registry/src/bin/crash_visibility.rs"
        ]
      },
      "declared_commands": {}
    }
  ],
